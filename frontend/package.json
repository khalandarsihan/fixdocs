{
  "name": "fixdocs-frontend",
  "version": "1.0.0",
  "description": "Frontend for Document Processing System",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:css": "tailwindcss -i ./src/styles/base.css -o ../docproc/public/css/style.css",
    "dev:react": "webpack --mode development --watch",
    "dev:css": "tailwindcss -i ./src/styles/base.css -o ../docproc/public/css/style.css --watch",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:css\"",
    "clean": "rm -rf ../docproc/public/js/react/* ../docproc/public/css/*",
    "build:prod": "npm run clean && npm run build && npm run build:css"
  },
  "dependencies": {
    "frappe-react-sdk": "^1.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "chart.js": "^4.3.0",
    "react-chartjs-2": "^5.2.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-react": "^7.22.5",
    "@babel/runtime": "^7.22.10",
    "autoprefixer": "^10.4.15",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "postcss": "^8.4.27",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
